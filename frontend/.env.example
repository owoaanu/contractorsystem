# Backend API URL (leave empty or use /contractor in production subpath)
VITE_API_URL=http://localhost:3000

# Base Path (defaults to / in development, /contractor/ in production)
VITE_BASE_PATH=/

# Remita Payment Gateway Public Key and Inline JS
VITE_REMITA_PUBLIC_KEY=your_remita_public_key
VITE_REMITA_SCRIPT_URL=https://login.remita.net/payment/v1/remita-pay-inline.bundle.js
