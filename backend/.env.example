# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=contractor_registration

# Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Remita Payment Gateway Credentials
REMITA_MERCHANT_ID=your_merchant_id
REMITA_API_KEY=your_api_key
REMITA_BASE_URL=https://login.remita.net
REMITA_TEST_BASE_URL=https://remitademo.net

# Optional: CORS & Socket Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
SOCKET_PATH=/socket.io
